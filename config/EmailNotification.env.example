# Source this example after choosing the sending account. No password is stored here.
# These server settings are for a Gmail sender; change them for another provider.
export KUANG_NOTIFY_EMAIL='josephyck0828@gmail.com'
export KUANG_SMTP_HOST='smtp.gmail.com'
export KUANG_SMTP_PORT='465'
export KUANG_SMTP_SECURITY='ssl'
export KUANG_SMTP_USER='your-sending-account@gmail.com'
# KUANG_SMTP_FROM defaults to KUANG_SMTP_USER.
# Enter the sender's app password in your terminal, then export it:
# read -r -s -p 'SMTP app password: ' KUANG_SMTP_PASSWORD
# export KUANG_SMTP_PASSWORD
# printf '\n'
